# 公众号真实发布凭证模板（复制为 .env 后填写；.env 不入库）
# 获取位置：mp.weixin.qq.com → 设置与开发 → 基本配置
WECHAT_APPID=你的AppID
WECHAT_APPSECRET=你的AppSecret


# AI 生稿（可选）：OpenAI 兼容接口。不填则工作台「AI 生稿」步骤不可用，其余功能不受影响
# DeepSeek（推荐，便宜）：注册 platform.deepseek.com → API Keys 创建 key → 充值；模型用 deepseek-v4-flash / deepseek-v4-pro（注意 deepseek-chat 老名已于 2026-07-24 停用）
# 通义千问：AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  AI_MODEL=qwen-plus   key 在百炼平台获取
# OpenAI：AI_BASE_URL=https://api.openai.com/v1  AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
