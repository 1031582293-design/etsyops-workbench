# 公众号真实发布凭证模板（复制为 .env 后填写；.env 不入库）
# 获取位置：mp.weixin.qq.com → 设置与开发 → 基本配置
WECHAT_APPID=你的AppID
WECHAT_APPSECRET=你的AppSecret


# AI 生稿（可选）：OpenAI 兼容接口。不填则工作台「AI 生稿」步骤不可用，其余功能不受影响
# 例（DeepSeek）：AI_BASE_URL=https://api.deepseek.com  AI_MODEL=deepseek-chat
# 例（通义）：AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  AI_MODEL=qwen-plus
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
